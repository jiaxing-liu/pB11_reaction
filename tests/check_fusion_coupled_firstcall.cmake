if(MODE STREQUAL "unset")
    set(environment "--unset=BALDUR_FUSION_TRIAL_TIMING")
    set(enabled FALSE)
elseif(MODE STREQUAL "empty")
    set(environment "BALDUR_FUSION_TRIAL_TIMING=")
    set(enabled FALSE)
elseif(MODE STREQUAL "one")
    set(environment "BALDUR_FUSION_TRIAL_TIMING=1")
    set(enabled TRUE)
elseif(MODE STREQUAL "zero")
    set(environment "BALDUR_FUSION_TRIAL_TIMING=0")
    set(enabled TRUE)
else()
    message(FATAL_ERROR "Unknown environment mode")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "${environment}" "${TEST_PROGRAM}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
message("${output}")
if(NOT status EQUAL 0 OR NOT output MATCHES "FIRSTCALL_PASS")
    message(FATAL_ERROR "First-call regression failed: ${status} ${errors}")
endif()
string(REGEX MATCHALL "FUSION_CXX_STAGE begin" begins "${output}")
string(REGEX MATCHALL "FUSION_CXX_STAGE complete" completes "${output}")
list(LENGTH begins begin_count)
list(LENGTH completes complete_count)
if(enabled)
    if(NOT begin_count EQUAL 9 OR NOT complete_count EQUAL 9)
        message(FATAL_ERROR "Expected all nine calls to emit timing stages: ${begin_count}/${complete_count}")
    endif()
elseif(output MATCHES "FUSION_CXX_STAGE")
    message(FATAL_ERROR "Disabled timing emitted stages")
endif()
message("FIRSTCALL_STDOUT_PASS mode=${MODE} enabled=${enabled} begins=${begin_count} completes=${complete_count}")
